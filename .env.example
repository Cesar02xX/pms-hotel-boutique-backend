# Copiar a .env (ignorado por git) y ajustar valores locales.
# Docker Compose lee .env automáticamente desde la raíz del repo.

# --- PostgreSQL de la aplicación (docker-compose.yml) ---
POSTGRES_DB=pms_hotel_db
POSTGRES_USER=pms_user
POSTGRES_PASSWORD=pms_password
POSTGRES_PORT=5432

# --- Backend (variables leídas por Spring Boot al ejecutar la API) ---
# Spring Boot las carga desde .env (spring.config.import opcional); las variables del sistema tienen prioridad.
JWT_SECRET=change-me-with-at-least-32-bytes-secret
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000
PMS_HOTEL_ZONE_ID=America/Guatemala

# --- SonarQube self-hosted (docker-compose.sonarqube.yml) ---
SONARQUBE_PORT=9000
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar_password
SONAR_DB_NAME=sonarqube
# Contraseña de admin usada por scripts/sonarqube/setup-sonarqube.sh (no commitear)
SONAR_ADMIN_PASSWORD=

# --- Análisis local con Maven (mismos nombres que los secrets de GitHub/Jenkins) ---
SONAR_HOST_URL=http://localhost:9000
SONAR_PROJECT_KEY=pms-hotel-boutique-backend
SONAR_TOKEN=
